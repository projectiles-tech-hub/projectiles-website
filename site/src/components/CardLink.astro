---
import Icon from './Icon.astro';
interface Props { label: string }
const { label } = Astro.props;
---
<span class="card-link t-strong" aria-hidden="true">{label}<Icon name="arrow-right" size={20} /></span>
<style>
  .card-link { display: inline-flex; align-items: center; gap: 8px; padding-top: 8px; color: var(--link); font-weight: 500; transition: gap var(--t-hover) var(--ease-standard); }
</style>
