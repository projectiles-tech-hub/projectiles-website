---
import Icon from './Icon.astro';
import Button from './Button.astro';
interface Props { icon?: string; title: string; text: string; action?: { label: string; href: string } }
const { icon = 'video', title, text, action } = Astro.props;
---
<div class="empty">
  <Icon name={icon} size={32} />
  <p class="t-h4">{title}</p>
  <p class="c-2">{text}</p>
  {action && <div class="empty__act"><Button variant="text" href={action.href} label={action.label} icon="arrow-up-right" /></div>}
</div>
<style>
  .empty { display: flex; flex-direction: column; gap: 12px; padding: 32px; background: var(--bg-subtle); max-width: 820px; }
  .empty__act { margin-left: -8px; }
</style>
