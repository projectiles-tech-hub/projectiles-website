---
import Icon from './Icon.astro';
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
type Item = { title: string; topic: string; image?: ImageMetadata; youtube?: string };
interface Props { items: Item[]; id?: string }
const { items, id = 'gallery-grid' } = Astro.props;
const full = await Promise.all(items.map(async (it) => (it.image ? (await getImage({ src: it.image, width: 1600, format: 'webp' })).src : '')));
---
<ul class="gal" id={id}>
  {items.map((it, i) => (
    <li data-topic={it.topic}>
      <button type="button" class="gal__tile" data-gal-open={i} data-full={full[i]} data-youtube={it.youtube} data-title={it.title}>
        {it.image ? <Picture src={it.image} alt="" formats={['avif', 'webp']} widths={[300, 600]} sizes="(min-width: 1200px) 300px, 50vw" />
          : it.youtube ? <img src={`https://i.ytimg.com/vi/${it.youtube}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" />
          : <span class="gal__ph" aria-hidden="true"><Icon name="image" size={32} /><span class="t-label">Photo (placeholder)</span></span>}
        {it.youtube && <span class="gal__play" aria-hidden="true"><Icon name="play" variant="duotone" /></span>}
        <span class="visually-hidden">{it.youtube ? 'Play video: ' : 'Open photo: '}{it.title}</span>
      </button>
    </li>
  ))}
</ul>
<dialog class="viewer on-dark" data-gal-viewer aria-label="Gallery viewer">
  <div class="viewer__bar">
    <p class="t-strong" data-gal-count aria-live="polite"></p>
    <button type="button" class="viewer__btn" data-gal-close><Icon name="close" /><span class="visually-hidden">Close</span></button>
  </div>
  <div class="viewer__stage" data-gal-stage></div>
  <p class="viewer__cap" data-gal-cap></p>
  <div class="viewer__nav">
    <button type="button" class="viewer__btn" data-gal-prev><Icon name="arrow-left" /><span class="visually-hidden">Previous</span></button>
    <button type="button" class="viewer__btn" data-gal-next><Icon name="arrow-right" /><span class="visually-hidden">Next</span></button>
  </div>
</dialog>
<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-gal-viewer]');
  if (dlg) {
    const stage = dlg.querySelector<HTMLElement>('[data-gal-stage]')!;
    const cap = dlg.querySelector<HTMLElement>('[data-gal-cap]')!;
    const count = dlg.querySelector<HTMLElement>('[data-gal-count]')!;
    let idx = 0; let opener: HTMLElement | null = null;
    const tiles = () => [...document.querySelectorAll<HTMLButtonElement>('[data-gal-open]')].filter((t) => !t.closest('li')?.hidden);
    const show = (i: number) => {
      const list = tiles(); idx = (i + list.length) % list.length; const t = list[idx];
      count.textContent = `${idx + 1} of ${list.length}`; cap.textContent = t.dataset.title ?? '';
      if (t.dataset.youtube) {
        const f = document.createElement('iframe'); f.src = `https://www.youtube-nocookie.com/embed/${t.dataset.youtube}?autoplay=1&rel=0`; f.title = t.dataset.title ?? 'Video'; f.allow = 'autoplay; encrypted-media; fullscreen'; f.allowFullscreen = true; stage.replaceChildren(f);
      } else if (t.dataset.full) {
        const img = document.createElement('img'); img.src = t.dataset.full; img.alt = t.dataset.title ?? ''; stage.replaceChildren(img);
      } else {
        const p = document.createElement('div'); p.className = 'viewer__ph'; p.textContent = 'Photo (placeholder)'; stage.replaceChildren(p);
      }
    };
    document.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-gal-open]');
      if (!t) return; opener = t; dlg.showModal(); show(tiles().indexOf(t));
    });
    dlg.querySelector('[data-gal-close]')!.addEventListener('click', () => dlg.close());
    dlg.querySelector('[data-gal-prev]')!.addEventListener('click', () => show(idx - 1));
    dlg.querySelector('[data-gal-next]')!.addEventListener('click', () => show(idx + 1));
    dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(idx - 1); if (e.key === 'ArrowRight') show(idx + 1); });
    dlg.addEventListener('close', () => { stage.replaceChildren(); opener?.focus(); });
    let x0 = 0;
    stage.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    stage.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 50) show(idx + (dx < 0 ? 1 : -1)); });
  }
</script>
<style>
  .gal { list-style: none; padding: 0; display: grid; gap: 8px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .gal li[hidden] { display: none; }
  @media (min-width: 768px) { .gal { gap: 16px; grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1200px) { .gal { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .gal__tile { position: relative; display: block; width: 100%; aspect-ratio: 1; padding: 0; border: 0; background: var(--bg-subtle); cursor: zoom-in; overflow: hidden; }
  .gal__tile :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform var(--t-reveal) var(--ease-standard); }
  .gal__tile:hover :global(img) { transform: scale(1.03); }
  .gal__ph { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; color: var(--green-800); text-align: center; padding: 8px; }
  .gal__play { position: absolute; left: 50%; top: 50%; width: 56px; height: 56px; margin: -28px 0 0 -28px; border-radius: 999px; background: var(--white); color: var(--green-700); display: flex; align-items: center; justify-content: center; }
  .viewer { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0 12px 24px; border: 0; background: var(--ink-900); color: var(--white); }
  .viewer[open] { display: flex; flex-direction: column; align-items: center; }
  .viewer::backdrop { background: var(--ink-900); }
  .viewer__bar { width: 100%; display: flex; justify-content: space-between; align-items: center; min-height: 72px; }
  .viewer__stage { flex: 1; width: 100%; max-width: 1100px; display: flex; align-items: center; justify-content: center; min-height: 0; }
  .viewer__stage :global(img) { max-height: 100%; object-fit: contain; }
  .viewer__stage :global(iframe) { width: 100%; aspect-ratio: 16 / 9; border: 0; }
  .viewer__stage :global(.viewer__ph) { width: 100%; max-width: 760px; aspect-ratio: 4 / 3; background: var(--green-50); color: var(--green-800); display: flex; align-items: center; justify-content: center; font-weight: 500; }
  .viewer__cap { color: var(--green-50); padding: 16px 0; text-align: center; }
  .viewer__nav { display: flex; gap: 16px; }
  .viewer__btn { width: 48px; height: 48px; border-radius: 999px; border: 0; background: transparent; color: var(--white); display: inline-flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: inset 0 0 0 1.5px var(--white); } /* taste-skill-ignore: approved Figma design (outline, form field or divider) */
  .viewer__btn:hover { background: rgba(255, 255, 255, 0.12); }
  .viewer__bar .viewer__btn { box-shadow: none; } /* taste-skill-ignore: approved Figma design (outline, form field or divider) */
  .viewer :focus-visible { outline-color: var(--white); }
  @media (min-width: 1200px) { .viewer { padding: 0 24px 32px; } }
</style>
