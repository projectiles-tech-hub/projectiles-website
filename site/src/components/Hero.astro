---
import Breadcrumbs from './Breadcrumbs.astro';
import Photo from './Photo.astro';
import Badge from './Badge.astro';
import type { ImageMetadata } from 'astro';
interface Props { crumbs?: { label: string; href?: string }[]; label?: string; heading: string; text?: string; ratio?: '16:9' | '4:3' | '3:2' | '1:1' | '4:5'; photo?: ImageMetadata | null; badge?: 'Coming soon' | 'Now selling' | 'Sold out'; display?: boolean; noPhoto?: boolean; mobileRatio?: string }
const { crumbs, label, heading, text, ratio = '4:3', photo, badge, display = false, noPhoto = false, mobileRatio } = Astro.props;
---
<section class:list={['hero', { 'hero--text': noPhoto }]} aria-labelledby="page-title">
  {crumbs && <Breadcrumbs items={crumbs} />}
  <div class="wrap hero__inner">
    <div class="hero__text">
      {badge && <Badge status={badge} />}
      {label && <p class="t-label c-link">{label}</p>}
      <h1 id="page-title" class={display ? 't-display' : 't-h1'}>{heading}</h1>
      {text && <p class="t-body-lg c-2">{text}</p>}
      <slot name="extra" />
      {Astro.slots.has('actions') && <div class="hero__actions"><slot name="actions" /></div>}
    </div>
    {!noPhoto && <div class="hero__media" style={mobileRatio ? `--m-ratio:${mobileRatio.replace(':','/')}` : undefined}><Photo src={photo ?? undefined} ratio={ratio} eager sizes="(min-width: 1200px) 607px, 100vw" /></div>}
  </div>
</section>
<style>
  .hero { background: var(--bg-surface); }
  .hero__inner { display: grid; gap: 24px; padding-top: 24px; padding-bottom: 48px; }
  .hero__text { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .hero__text > :global(*) { max-width: 820px; }
  .hero__actions { display: flex; flex-direction: column; gap: 12px; padding-top: 8px; width: 100%; }
  .hero__actions :global(.btn) { width: 100%; }
  @media (max-width: 1199px) { .hero__media[style] :global(.photo) { aspect-ratio: var(--m-ratio) !important; } }
  @media (min-width: 768px) {
    .hero__inner { gap: 40px; padding-top: 48px; padding-bottom: 80px; }
    .hero__text { gap: 24px; }
    .hero__actions { flex-direction: row; flex-wrap: wrap; gap: 16px; width: auto; }
    .hero__actions :global(.btn) { width: auto; }
  }
  @media (min-width: 1200px) {
    .hero__inner { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; align-items: center; padding-bottom: 96px; }
    .hero--text .hero__inner { grid-template-columns: 1fr; }
  }
</style>
