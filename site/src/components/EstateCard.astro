---
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import Badge from './Badge.astro';
import CardLink from './CardLink.astro';
import type { ImageMetadata } from 'astro';
interface Props { href: string; name: string; location: string; summary: string; status: 'Coming soon' | 'Now selling' | 'Sold out'; word: string; photo?: ImageMetadata; headingLevel?: 'h2' | 'h3' }
const { href, name, location, summary, status, word, photo, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---
<article class="card estate">
  <div class="estate__media">
    {photo ? <Photo src={photo} ratio="4:3" alt="" /> : (
      <div class="estate__panel" aria-hidden="true"><span class="t-h1">{word}</span><Icon name="plot" size={32} /></div>
    )}
    <div class="estate__badge"><Badge status={status} /></div>
  </div>
  <div class="card__body">
    <H class="t-h4 card__title"><a href={href} class="card__stretch">{name}</a></H>
    <p class="estate__loc t-small c-2"><Icon name="location" size={20} />{location}</p>
    <p class="c-2">{summary}</p>
    <CardLink label="View estate" />
  </div>
</article>
<style>
  .estate__media { position: relative; }
  .estate__panel { aspect-ratio: 4 / 3; background: var(--bg-inverse); color: var(--white); display: flex; flex-direction: column; justify-content: flex-end; gap: 12px; padding: 24px; }
  .estate__panel :global(svg) { color: var(--green-50); order: -1; margin-bottom: auto; margin-left: auto; }
  .estate__badge { position: absolute; top: 16px; left: 16px; }
  .estate__loc { display: flex; align-items: center; gap: 8px; }
  .estate__loc :global(svg) { flex: none; }
</style>
