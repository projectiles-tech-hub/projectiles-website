---
import Icon from './Icon.astro';
interface Props { id: string; title: string; date: string; length?: string; headingLevel?: 'h2' | 'h3' }
const { id, title, date, length, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const d = new Date(date);
const nice = isNaN(+d) ? date : d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<article class="vcard">
  <div class="vcard__thumb">
    <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" />
    <span class="vcard__play" aria-hidden="true"><Icon name="play" variant="duotone" /></span>
    {length && <span class="vcard__len t-label">{length}</span>}
  </div>
  <div class="vcard__body">
    <H class="t-subtitle"><a class="card__stretch" href={`https://www.youtube.com/watch?v=${id}`} target="_blank" rel="noopener">{title}<span class="visually-hidden"> (watch on YouTube, opens in a new tab)</span></a></H>
    <p class="t-small c-2"><time datetime={d.toISOString?.() ?? date}>{nice}</time></p>
  </div>
</article>
<style>
  .vcard { position: relative; }
  .vcard__thumb { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: var(--bg-subtle); }
  .vcard__thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--t-reveal) var(--ease-standard); }
  .vcard:hover .vcard__thumb img { transform: scale(1.03); }
  .vcard__play { position: absolute; left: 50%; top: 50%; width: 56px; height: 56px; margin: -28px 0 0 -28px; border-radius: 999px; background: var(--white); display: flex; align-items: center; justify-content: center; color: var(--green-700); }
  .vcard__len { position: absolute; right: 8px; bottom: 8px; padding: 4px 8px; background: var(--bg-inverse); color: var(--white); }
  .vcard__body { padding-top: 16px; display: flex; flex-direction: column; gap: 4px; }
  .vcard a { color: var(--text); text-decoration: none; }
  .vcard:hover a { color: var(--link); }
</style>
